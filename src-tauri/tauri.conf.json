{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RefBible",
  "version": "0.1.0",
  "identifier": "com.refbible.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node scripts/build-seeded-db.js && pnpm dev",
    "beforeBuildCommand": "node scripts/build-seeded-db.js && pnpm build && node -e \"const fs=require('fs'),p='dist';require('fs').readdirSync(p,{recursive:true,withFileTypes:true}).filter(d=>d.isFile()&&(d.name.endsWith('.json')||d.name.endsWith('.gz'))).forEach(f=>{const fp=require('path').join(f.path,f.name);console.log('clean: '+fp);require('fs').unlinkSync(fp)})\""
  },
  "app": {
    "windows": [
      {
        "title": "RefBible",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://raw.githubusercontent.com ws://localhost:5173 http://localhost:5173; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "bundled/refbible.db.gz": "refbible.db.gz"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
